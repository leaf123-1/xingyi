# 数据库连接，开发可使用 SQLite：
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://user:password@localhost:5432/xingyi"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="please-change-me"

# NEXT_PUBLIC_SITE_URL 可用于覆盖 sitemap/robots 等生成的站点地址
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
EMAIL_FROM="no-reply@xingyi.local"

# 媒资上传配置：开发默认写入 public/uploads，可切换 S3 兼容存储
STORAGE_DRIVER="local" # 可选 local | s3
UPLOAD_LOCAL_DIR="public/uploads"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="" # 可选：自定义 CDN / 域名，未设置时自动拼接桶域名

# 支付相关配置（上线需替换为真实商户/密钥/回调 URL）
PAYMENT_PROVIDER="alipay"
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_WEBHOOK_SECRET=""
ALIPAY_NOTIFY_URL="http://localhost:3000/api/payments/alipay/webhook"
ALIPAY_RETURN_URL="http://localhost:3000/checkout/complete"
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_KEY=""
WECHAT_NOTIFY_URL="http://localhost:3000/api/payments/wechat/webhook"
WECHAT_RETURN_URL="http://localhost:3000/checkout/complete"
