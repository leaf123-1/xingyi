/// Prisma 客户端生成配置
/// 关键：保持数据库提供者与 .env 中一致
generator client {
  provider = "prisma-client-js"
}

/// 数据源配置（默认 PostgreSQL，开发期可改为 SQLite）
datasource db {
  /// 默认使用 PostgreSQL；如需切换其他数据库，请同步更新 provider 并校验字段兼容性
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 用户角色枚举，覆盖后台/前台权限
enum UserRole {
  ADMIN
  EDITOR
  CUSTOMER
}

/// 商品上下架状态
enum ProductStatus {
  DRAFT
  PUBLISHED
}

/// 订单状态机
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  FULFILLED
}

/// 支付通道类型
enum PaymentProvider {
  alipay
  wechat
  stripe
}

/// 支付状态追踪
enum PaymentStatus {
  INIT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// CMS 内容发布状态
enum PublishStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

/// 联系表单状态
enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model User {
  /// 用户唯一标识
  id           String    @id @default(cuid())
  /// 登录邮箱
  email        String    @unique
  /// 显示名称
  name         String?
  /// 登录密码哈希（第三方登录可为空）
  passwordHash String?
  /// 头像
  image        String?
  /// 角色
  role         UserRole  @default(CUSTOMER)

  /// 关联：购物车、订单、内容
  carts        Cart[]
  orders       Order[]
  articles     Article[] @relation("ArticleAuthor")
  pages        Page[]    @relation("PageAuthor")

  /// NextAuth 账号 & 会话
  accounts     Account[]
  sessions     Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sort      Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sort])
  @@index([createdAt])
}

model Product {
  id              String         @id @default(cuid())
  name            String
  subtitle        String?
  slug            String         @unique
  description     String
  specs           Json?
  coverImage      String
  gallery         String[]       @default([])
  price           Decimal        @db.Decimal(10, 2)
  compareAtPrice  Decimal?       @db.Decimal(10, 2)
  status          ProductStatus  @default(DRAFT)
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  variants        Variant[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Variant {
  id         String   @id @default(cuid())
  sku        String   @unique
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attrs      Json?
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  stock      Int      @default(0)
  barcode    String?
  orderItems OrderItem[]
  cartItems  CartItem[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([stock])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
  orders    Order[]
  currency  String     @default("CNY")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  variantId  String?
  variant    Variant? @relation(fields: [variantId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Order {
  id             String       @id @default(cuid())
  orderNumber    String       @unique
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  status         OrderStatus  @default(PENDING)
  currency       String       @default("CNY")
  subtotalAmount Decimal      @db.Decimal(10, 2)
  shippingAmount Decimal      @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal      @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal      @db.Decimal(10, 2)
  cartId         String?
  cart           Cart?        @relation(fields: [cartId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id])
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
}

model Payment {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     PaymentProvider
  intentId     String?
  transactionId String?
  status       PaymentStatus   @default(INIT)
  amount       Decimal         @db.Decimal(10, 2)
  rawPayload   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      PublishStatus @default(DRAFT)
  authorId    String?
  author      User?         @relation("ArticleAuthor", fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Page {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String
  status      PublishStatus @default(DRAFT)
  authorId    String?
  author      User?         @relation("PageAuthor", fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id         String        @id @default(cuid())
  name       String
  email      String?
  phone      String?
  message    String
  sourcePath String?
  status     ContactStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// NextAuth 所需模型保留
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refreshToken")
  access_token      String? @map("accessToken")
  expires_at        Int?    @map("expiresAt")
  token_type        String? @map("tokenType")
  scope             String?
  id_token          String? @map("idToken")
  session_state     String? @map("sessionState")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
